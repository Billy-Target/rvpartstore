# Copy to .env (gitignored) and fill in real values. Paths are relative to
# the project root unless absolute.

# --- Shopify (thervpartstore.myshopify.com, client-credentials grant) ---
SHOPIFY_SHOP=thervpartstore.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_LOCATION_ID=118096265348

# --- MySQL ---
MYSQL_HOST=192.168.20.12
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=inventory
ORDER_TABLE=shopify_rvmarines_order
FULFILLMENT_TABLE=shopify_rvmarines_fulfillment
TXN_PREFIX=RVM_SP_N
STORE_TYPE=shopifyca_rv
ORDER_MAX_AGE_DAYS=60
# comma-separated Shopify order ids to always skip
ORDER_ID_BLOCKLIST=

# --- Amazon SP-API ---
AMAZON_REFRESH_TOKEN=
AMAZON_LWA_APP_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_AWS_ACCESS_KEY=
AMAZON_AWS_SECRET_KEY=
AMAZON_ROLE_ARN=
AMAZON_REPORT_PATH=data/amazon_report.txt

# --- Google (Sheets + Merchant) ---
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CREDENTIALS_PATH=credentials.json
RMA_SHEET_ID=1Yk_2rIDUFpaX32n5Zgw39duUe3-VkqB-qAbdZheU_CE
RMA_SHEET_RANGE=abaaba!A:D
UPC_EXCEPTION_PATH=
GOOGLE_MERCHANT_ENABLED=false
GOOGLE_MERCHANT_ID=645493236

# --- Runtime ---
DRY_RUN=true
LOG_NAME=rvpartstore
QUIET_START=23:30
QUIET_END=06:30

# --- Guards (R5/R7/V5) ---
TRACKING_AUTOFIX_MAX=500
BREAKER_ZERO_PCT=20
BREAKER_PRICE_PCT=20
FEED_MATCH_MIN=19000

# --- Brakex (B1; static admin token for brakex.myshopify.com) ---
BRAKEX_ENABLED=true
BRAKEX_SHOP=brakex.myshopify.com
BRAKEX_ACCESS_TOKEN=
BRAKEX_ORDER_TABLE=shopify_brakex_order
BRAKEX_TXN_PREFIX=BRX_SP_37
BRAKEX_STORE_TYPE=shopifycom_brx
# comma-separated Shopify order ids to always skip
BRAKEX_ORDER_ID_BLOCKLIST=
BRAKEX_USD_TO_CAD=1.35
